BUILD=build

KERNEL=$(BUILD)/kernel.elf
BIN=$(BUILD)/kernel.bin

# إضافة -I. لجعل المجلد الرئيسي هو جذر التضمين
CFLAGS=-ffreestanding \
        -fno-stack-protector \
        -mno-red-zone \
        -nostdlib \
        -I.

# أعلام مجمع NASM
NASMFLAGS=-f elf64 -g

LDFLAGS=-T ربط_الملفات.ld

